{
  // === Python / Backend (Windows native) ===
  "python.defaultInterpreterPath": "${workspaceFolder}\\.venv\\Scripts\\python.exe",
  "python.venvPath": "${workspaceFolder}",
  "python.terminal.activateEnvironment": true,
  "python.terminal.activateEnvInCurrentTerminal": true,
  "python.terminal.useEnvFile": true,
  "python.analysis.typeCheckingMode": "standard",
  "python.analysis.extraPaths": ["./backend"],
  "[python]": {
    "editor.insertSpaces": false,
    "editor.detectIndentation": false,
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "charliermarsh.ruff",
    "editor.codeActionsOnSave": {
      "source.fixAll.ruff": "explicit",
      "source.organizeImports.ruff": "explicit"
    }
  },
  "ruff.enable": true,

  // ESLint formatting support (for JS/TS as per project policy)
  "eslint.format.enable": true,
  "editor.codeActionsOnSave": {
    "source.fixAll.eslint": "explicit"
  },

  // === General workspace (Windows + large project friendly) ===
  "search.exclude": {
    "**/.venv": true,
    "**/node_modules": true,
    "**/dist": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true
  },
  "files.exclude": {
    "**/.venv": true,
    "**/__pycache__": true,
    "**/.ruff_cache": true
  },
  "files.watcherExclude": {
    "**/.venv/**": true,
    "**/node_modules/**": true
  },

  // === Frontend formatting (ESLint policy per AGENTS.md — no Prettier for code) ===
  // ESLint extension handles lint + format for JS/TS/TSX via code actions and defaultFormatter.
  // Prettier is deliberately excluded for these languages (no .prettierrc ships).
  "[javascript][typescript][html][css]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "dbaeumer.vscode-eslint"
  },
  // Prettier can still be used for docs/config if desired (falls back to VS Code settings since no .prettierrc)
  "[markdown][yaml]": {
    "editor.formatOnSave": true,
    "editor.defaultFormatter": "esbenp.prettier-vscode"
  }
}
