{
    "servers": {
        "com.supabase/mcp": {
            "type": "http",
            "url": "https://mcp.supabase.com/mcp",
            "headers": {
                "Authorization": "Bearer ${env:SUPABASE_MCP_TOKEN}"
            }
        },
        "chrome-devtools": {
            "type": "stdio",
            "command": "cmd",
            "args": ["/c", "npx", "-y", "chrome-devtools-mcp@latest"]
        }
    }
}