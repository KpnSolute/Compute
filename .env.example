# FastAPI
SECRET_KEY=change-me-in-production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret
SUPABASE_MCP_TOKEN=your-mcp-token
SUPABASE_PAT=your-supabase-pat

# GitHub — SOURCE CODE repo (Render deploys from this)
# git remote origin = muttyman2000/MJCC-Managements-
# Set this in Render dashboard; do not hardcode.

# GitHub — DATA ARCHIVE repo (in-app Source Control sync target)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=MJCC-Portal/mjcc
GITHUB_BRANCH=main

# AI
AI_PROVIDER=ollama
AI_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
GEMINI_API_KEY=

# File Vault / durable archives — Garage (S3-compatible) at the home Proxmox box.
# The Render backend PROXIES all uploads/downloads, so it must reach this
# endpoint from the cloud. A LAN address (http://192.168.x.x:3900) will NOT work
# from Render — expose Garage through a public HTTPS tunnel (Cloudflare Tunnel
# recommended) and point MJCC_ARCHIVE_ENDPOINT at that https:// hostname.
# HTTPS is enforced; only set MJCC_ARCHIVE_ALLOW_INSECURE for a LAN-only dev box.
MJCC_ARCHIVE_ENDPOINT=https://garage.example.com
MJCC_ARCHIVE_ACCESS_KEY=your-garage-access-key
MJCC_ARCHIVE_SECRET_KEY=your-garage-secret-key
MJCC_ARCHIVE_BUCKET=mjcc-archive
MJCC_ARCHIVE_REGION=mjcc
# MJCC_ARCHIVE_ALLOW_INSECURE=  # leave unset in prod (keeps HTTPS mandatory)
# MJCC_ARCHIVE_REQUIRED=true    # once verified, fail uploads closed if archiving is down

# CORS — set to deployed frontend URL in production
CORS_ORIGINS=http://localhost:5173,https://compute.kpnsolute.com,https://mjcc.kpnsolute.com

# Server
PORT=8000
MJCC_LOG_MODE=live
# Tenant rollout safety: legacy (no schema dependency), shadow (scoped), or
# enforced (fail closed without an active workspace).
KPNCOMPUTE_TENANCY_MODE=legacy
KPNCOMPUTE_DEFAULT_TENANT_SLUG=mjcc
# Explicit staff session signing key. Independent of Supabase credentials.
# Required for staff login; sessions fail closed without it.
KPNCOMPUTE_STAFF_SESSION_SECRET=
# Server-only, read-only CLI diagnostic key. Set a long random value in Render;
# never commit or expose the value. The CLI uses KPNCOMPUTE_DIAGNOSTIC_KEY.
MJCC_DIAGNOSTIC_LOG_KEY=
KPNCOMPUTE_API_URL=https://api.kpnsolute.com/compute
KPNCOMPUTE_DIAGNOSTIC_KEY=

# Frontend (set as Render build-time env var)
VITE_API_BASE=https://api.kpnsolute.com/compute

# Optional dedicated server-only SSO bridge secret. If omitted, both servers
# derive a purpose-specific HMAC key from their existing MJCCv1 service key.
LUNCHVOICE_SSO_SECRET=
LUNCHVOICE_SSO_URL=https://interact-3npi.onrender.com/LionCafe/sso

# Generic, app-scoped SSO handoff (POST /api/auth/sso/{app}/start|exchange).
# Each allowlisted app in SSO_APPS (backend/routes/auth.py) needs its own
# dedicated secret + callback env var; both are required (fail closed if
# unset, no hardcoded production default). Marquee is the first app on this
# path; add a new SSO_APPS entry + matching env vars for any future app.
MARQUEE_SSO_SECRET=
MARQUEE_SSO_URL=

# KpnSolute Events — server-only CloudEvents menu publishing. Leave all three
# blank to disable publishing without affecting menu writes.
KPNSOLUTE_EVENTS_URL=
KPNSOLUTE_EVENTS_PUBLISHER_KEY=
# Legacy-only fallback. Shadow/enforced mode derives the immutable tenant UUID
# from the authenticated request context.
KPNSOLUTE_TENANT_ID=mjcc
