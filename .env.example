# FastAPI
SECRET_KEY=change-me-in-production

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_KEY=your-service-role-key
SUPABASE_MCP_TOKEN=your-mcp-token
SUPABASE_PAT=your-supabase-pat

# GitHub — SOURCE CODE repo (Render deploys from this)
# git remote origin = muttyman2000/MJCC-Managements-
# Set this in Render dashboard; do not hardcode.

# GitHub — DATA ARCHIVE repo (in-app Source Control sync target)
GITHUB_TOKEN=ghp_...
GITHUB_REPO=MJCC-Portal/mjcc
GITHUB_BRANCH=main

# AI
AI_PROVIDER=ollama
AI_MODEL=llama3.2:3b
GROQ_API_KEY=
GROQ_MODEL=mixtral-8x7b-32768
GEMINI_API_KEY=

# File Vault / durable archives — Garage (S3-compatible) at the home Proxmox box.
# The Render backend PROXIES all uploads/downloads, so it must reach this
# endpoint from the cloud. A LAN address (http://192.168.x.x:3900) will NOT work
# from Render — expose Garage through a public HTTPS tunnel (Cloudflare Tunnel
# recommended) and point MJCC_ARCHIVE_ENDPOINT at that https:// hostname.
# HTTPS is enforced; only set MJCC_ARCHIVE_ALLOW_INSECURE for a LAN-only dev box.
MJCC_ARCHIVE_ENDPOINT=https://garage.example.com
MJCC_ARCHIVE_ACCESS_KEY=your-garage-access-key
MJCC_ARCHIVE_SECRET_KEY=your-garage-secret-key
MJCC_ARCHIVE_BUCKET=mjcc-archive
MJCC_ARCHIVE_REGION=mjcc
# MJCC_ARCHIVE_ALLOW_INSECURE=  # leave unset in prod (keeps HTTPS mandatory)
# MJCC_ARCHIVE_REQUIRED=true    # once verified, fail uploads closed if archiving is down

# CORS — set to deployed frontend URL in production
CORS_ORIGINS=http://localhost:5173

# Server
PORT=8000

# Frontend (set as Render build-time env var)
VITE_API_BASE=http://localhost:8000

# Optional dedicated server-only SSO bridge secret. If omitted, both servers
# derive a purpose-specific HMAC key from their existing MJCCv1 service key.
LUNCHVOICE_SSO_SECRET=
LUNCHVOICE_SSO_URL=https://interact-3npi.onrender.com/LionCafe/sso
