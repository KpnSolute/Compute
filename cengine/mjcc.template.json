        "sort_order": {
          "type": "integer",
          "default": 0,
          "indexed": true
        },
        "active": {
          "type": "boolean",
          "default": true
        }
      },
      "sort_keys": [
        "sort_order"
      ]
    },
    "budget_line_actual": {
      "fields": {
        "line_item": {
          "type": "ref",
          "ref": "budget_line_item",
          "indexed": true,
          "required": true
        },
        "period": {
          "type": "ref",
          "ref": "period",
          "indexed": true,
          "required": true
        },
        "actual_key": {
          "type": "string",
          "max_length": 100,
          "unique": true,
          "indexed": true,
          "computed": "concat(line_item, '|', period)"
        },
        "actual_amount": {
          "type": "decimal",
          "precision": 12,
          "scale": 2,
          "default": 0
        },
        "updated_by": {
          "type": "string",
          "max_length": 120
        }
      },
      "locked_when": "ref(period).status == 'closed'"
    },
    "staff_member": {
