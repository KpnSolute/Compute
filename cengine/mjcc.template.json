      ]
    },
    "import_batch": {
      "fields": {
        "source": {
          "type": "string",
          "max_length": 60,
          "required": true
        },
        "filename": {
          "type": "string",
          "max_length": 240,
          "required": true
        },
        "period": {
          "type": "ref",
          "ref": "period",
          "indexed": true
        },
        "items_imported": {
          "type": "integer",
          "default": 0
        },
        "items_skipped": {
          "type": "integer",
          "default": 0
        },
        "status": {
          "type": "enum",
          "values": [
