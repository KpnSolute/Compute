          "max_length": 120,
          "pii": true
        },
        "last_name": {
          "type": "string",
          "max_length": 120,
          "pii": true
        },
        "role": {
          "type": "enum",
          "values": [
            "staff",
            "assistant",
            "manager",
            "admin",
            "sudo"
          ],
          "required": true,
          "indexed": true
        },
        "email": {
          "type": "string",
          "max_length": 254,
          "pii": true
        },
        "phone": {
          "type": "string",
          "max_length": 40,
          "pii": true
        },
        "job_title": {
          "type": "string",
          "max_length": 120
        },
        "bio": {
          "type": "text",
          "pii": true
        },
        "avatar": {
          "type": "file"
        },
        "active": {
          "type": "boolean",
          "default": true,
          "indexed": true
        },
        "last_login": {
          "type": "datetime"
        }
      },
      "sort_keys": [
        "username"
      ]
    },
    "app_setting": {
      "fields": {
        "setting_key": {
          "type": "string",
          "max_length": 80,
          "required": true,
          "unique": true,
          "indexed": true
        },
        "setting_value": {
          "type": "json",
          "required": true
        }
      },
      "sort_keys": [
        "setting_key"
      ]
    },
    "document": {
      "fields": {
        "title": {
          "type": "string",
          "max_length": 200,
          "required": true,
          "searchable": true,
          "indexed": true
        },
        "kind": {
          "type": "string",
          "max_length": 60,
          "indexed": true
        },
        "period": {
          "type": "ref",
          "ref": "period",
          "indexed": true
        },
        "file": {
          "type": "file"
        },
        "source": {
          "type": "string",
          "max_length": 60
        }
      },
