        "inventory_category",
        "vendor",
        "item_barcode",
        "inventory_line",
        "period",
        "period_week",
        "menu_item",
        "menu_cycle_day",
        "menu_cycle_slot",
        "meal_period",
        "cafeteria_event",
        "opening_checklist_item",
        "snack_bar_product",
        "snack_bar_rate",
        "haccp_log",
        "incident_log",
        "daily_operations_log",
        "snack_bar_transaction",
        "snack_bar_transaction_item",
        "snack_bar_sale",
        "servsafe_certification"
      ],
      "write": [
        "haccp_log",
        "incident_log",
        "daily_operations_log",
        "snack_bar_transaction",
        "snack_bar_transaction_item",
        "snack_bar_sale"
      ],
      "actions": []
    },
    "assistant": {
