  "projections": {
    "public_menu": {
      "entity": "menu_cycle_slot",
      "fields": [
        "cycle_day",
        "meal_group",
        "meal_period",
        "service_order",
        "slot_order",
        "slot_name",
        "item"
      ],
      "filter": "active == true"
    },
    "public_meal_periods": {
      "entity": "meal_period",
      "fields": [
        "meal",
        "label",
        "open_hour",
        "close_hour",
        "sort_order"
      ]
    },
    "public_menu_items": {
      "entity": "menu_item",
      "fields": [
        "name",
        "item_key"
      ],
      "filter": "active == true"
    }
  },
  "reports": {
    "stock_by_category": {
      "entity": "inventory_line",
      "title": "Inventory value",
      "group_by": [
        "period"
      ],
      "measures": [
        {
          "fn": "count",
          "as": "items"
        },
        {
          "fn": "sum",
          "field": "opening_value",
          "as": "opening_value"
        },
        {
          "fn": "sum",
          "field": "received_value",
          "as": "received_value"
        },
        {
          "fn": "sum",
          "field": "pulled_value",
          "as": "pulled_value"
        },
        {
          "fn": "sum",
          "field": "ending_value",
          "as": "ending_value"
        }
      ]
    },
    "invoice_spending": {
      "entity": "invoice",
      "title": "Purchasing by period and week",
      "group_by": [
        "period",
        "week_number"
      ],
      "measures": [
        {
          "fn": "count",
          "as": "invoices"
        },
        {
          "fn": "sum",
          "field": "subtotal",
          "as": "gross_received"
        },
        {
          "fn": "sum",
          "field": "vizient_discount",
          "as": "vizient_discount"
        },
        {
          "fn": "sum",
          "field": "fuel_surcharge",
          "as": "fuel_surcharge"
        },
        {
          "fn": "sum",
          "field": "net_total",
          "as": "net_received"
        }
      ]
    },
    "snack_bar_daily": {
      "entity": "snack_bar_transaction",
      "title": "Snack bar sales by day",
      "group_by": [
        "business_date",
        "entity_type"
      ],
      "measures": [
        {
          "fn": "count",
          "as": "transactions"
        },
        {
          "fn": "sum",
          "field": "total_amount",
          "as": "revenue"
        }
      ]
    },
    "haccp_by_location": {
      "entity": "haccp_log",
      "title": "HACCP checks by location",
      "group_by": [
        "location"
      ],
      "measures": [
        {
          "fn": "count",
          "as": "checks"
        },
        {
          "fn": "min",
          "field": "temperature",
          "as": "coldest"
        },
        {
          "fn": "max",
          "field": "temperature",
          "as": "warmest"
        }
      ]
    },
    "menu_feedback": {
      "entity": "menu_suggestion",
      "title": "Menu suggestions",
      "group_by": [
        "status"
      ],
      "measures": [
        {
          "fn": "count",
          "as": "suggestions"
        }
      ]
    }
  },
  "runtime": {
    "storage": {
      "relational": true,
      "files": true,
      "max_file_mb": 25
    },
    "network": {
      "public_projections": true
    }
  }
}