    - mi.w1_issued   - mi.w2_issued
    - mi.w3_issued   - mi.w4_issued
  ) * ii.unit_price                            AS item_total,
  -- weekly received values
  mi.w1_received * ii.unit_price               AS w1_value,
  mi.w2_received * ii.unit_price               AS w2_value,
  mi.w3_received * ii.unit_price               AS w3_value,
  mi.w4_received * ii.unit_price               AS w4_value,
