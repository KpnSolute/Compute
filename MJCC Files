ALTER TABLE public.monthly_snapshots
  DROP CONSTRAINT IF EXISTS monthly_snapshots_month_check;
ALTER TABLE public.monthly_snapshots
  ADD CONSTRAINT monthly_snapshots_month_check
  CHECK (month >= 0 AND month <= 11);

